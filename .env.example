# ---- Quality gates ----
# STORYBOARD_GATE: require (default, fail-closed) | warn | off | skip.
# Any other value fails closed. The API relaxes this to `warn` only inside
# dry-run child processes; production renders keep `require`.
STORYBOARD_GATE=
# DRY_RUN=1: local render-mechanics check with procedural visuals and
# calibration-tone audio. Artifacts are marked draft-only and are never
# publishable. Direct CLI dry-runs keep STORYBOARD_GATE's production default.
DRY_RUN=

# ---- Studio API (FastAPI) ----
# Bearer token required on /start, /jobs and /status. With no key set the API
# fails closed and serves 503 rather than running open.
SHORTS_STUDIO_API_KEY=
# Public destinations also need data/public_release_approved.json, not just this key.

# ---- Video generation ----
KLING_API_KEY=
KLING_USER_ID=

# ---- Storage paths ----
DEMO_VIDEO_PATH=
VIDEO_ARCHIVE_DIR=
# Empty uses the production default: deep_45s (45 seconds).
SCRIPT_PROFILE=
LONGFORM_PROFILE=
PUBLISH_MODE=
AUTO_PUBLISH_APPROVED=

# Recommended local default: edge_tts
TTS_PROVIDER=
# Keep local model fallback disabled unless explicitly opted in.
TTS_ALLOW_LOCAL_MODELS=
OPENVERSE_ENABLED=

# Creator-grade editorial direction. "auto" selects a story arc/style from the topic.
NEXTDECODE_STORY_FORMAT=
NEXTDECODE_VISUAL_STYLE=
# Optional overrides: explainer, mini_documentary, mystery_reveal, myth_bust,
# case_study, problem_solution, timeline, listicle, cinematic_essay.
# Visual styles: cinematic, documentary, newsroom, tech_editorial, minimal_motion.
