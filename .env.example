# ---- Core / AI ----
GEMINI_API_KEY=  # REQUIRED for AI scripts (free tier) https://aistudio.google.com/apikey
GROQ_API_KEY=  # optional free tier https://console.groq.com/keys
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=  # optional https://omniroute.local
OMNIROUTE_MODEL=groq/openai/gpt-oss-120b
OMNIROUTE_FALLBACK_MODELS=
AI_GENERATION_PROVIDER=auto
AI_PROVIDER_CHAIN=groq,omniroute,gemini,ollama  # order used by the fallback chain
AI_HEALTH_GATE=true  # skip providers that failed the last model_health probe
GROQ_MODEL=qwen/qwen3.8-27b  # verified live 2026-10-22
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash  # gemini-2.5-flash is retired for new users
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
ENABLE_TOKEN_BUDGET=false

# ---- Free fallback providers (auto-transfer when a provider hits its quota) ----
# LLM: Pollinations text is keyless and always available, no key needed.
POLLINATIONS_TEXT_URL=https://text.pollinations.ai/openai
POLLINATIONS_TEXT_MODEL=openai
NVIDIA_API_KEY=  # optional free tier (40 RPM) https://build.nvidia.com/
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=google/gemma-4-31b-it
CF_ACCOUNT_ID=  # optional free tier (10k neurons/day) https://dash.cloudflare.com/
CF_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_API_KEY=  # optional free models https://openrouter.ai/settings/keys
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=recursive/flint-v1.0:free
MISTRAL_API_KEY=  # optional free tier https://console.mistral.ai/api-keys
MISTRAL_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-4
CEREBRAS_API_KEY=  # optional free tier https://cloud.cerebras.ai/
CEREBRAS_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
# Images: Pollinations image is keyless; add the key only if you have one.
POLLINATIONS_API_KEY=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ---- Strong pipeline ----
VIDEO_QUALITY=strong  # strong (researched, multi-shot) | standard (legacy single pass)
WHISPER_MODEL=base  # faster-whisper model used for kinetic caption timings


# ---- Voice / TTS ----
TTS_PROVIDER=  # optional; edge_tts (free) default
TTS_MODEL=
TTS_VOICE=en-US-ChristopherNeural
ELEVENLABS_API_KEY=  # optional free tier https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=  # optional free tier https://play.cartesia.ai/
CARTESIA_VOICE_ID=
OPENAI_API_KEY=  # optional https://platform.openai.com/api-keys
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# ---- Visuals / Images ----
IMAGE_PROVIDER=  # optional
IMAGE_MODEL=
THUMBNAIL_PROVIDER=  # optional
VISUAL_PROVIDER=  # optional
FAL_KEY=  # optional free tier https://fal.ai/dashboard/keys
REPLICATE_API_TOKEN=  # optional https://replicate.com/account/api-tokens
PEXELS_API_KEY=  # optional (issuance paused) https://www.pexels.com/api/
PIXABAY_API_KEY=  # optional https://pixabay.com/api/docs/

# ---- Trending / Discovery ----
YOUTUBE_DATA_API_KEY=  # free https://console.cloud.google.com/apis/credentials
TRENDS_API_KEY=  # optional free tier https://developers.google.com/search/blog/2025/07/trends-api
TREND_GEO=IN
TREND_SOURCES=
REDDIT_CLIENT_ID=  # free https://www.reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=  # free https://www.reddit.com/prefs/apps
REDDIT_SUBREDDIT=
X_BEARER_TOKEN=  # optional https://developer.x.com/

# ---- Storage & Workspace ----
AIRTABLE_API_KEY=  # optional free tier https://airtable.com/create/tokens
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
NOTION_API_KEY=  # optional free tier https://www.notion.so/my-integrations
NOTION_DATABASE_ID=
SUPABASE_URL=  # optional free tier https://supabase.com/dashboard
SUPABASE_SERVICE_KEY=
CLOUDINARY_CLOUD_NAME=  # optional free tier https://cloudinary.com/
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=  # optional free tier https://dash.cloudflare.com/
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---- Publishing - Meta ----
META_GRAPH_API_VERSION=v22.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VIDEO_URL=
INSTAGRAM_TUNNEL_FALLBACK=false

# ---- Publishing - Extra Platforms ----
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
BLUESKY_IDENTIFIER=  # https://bsky.app/settings/app-passwords
BLUESKY_APP_PASSWORD=
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
DISCORD_WEBHOOK_URL=  # https://discord.com/developers/docs/resources/webhook
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=
GBP_ACCESS_TOKEN=
GBP_LOCATION_ID=
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=
RELAY_API_KEY=

# ---- Analytics ----
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_ACCESS_TOKEN=
YT_ANALYTICS_ENABLED=
META_INSIGHTS_ENABLED=

# ---- YouTube ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=  # optional https://core.telegram.org/bots/tutorial
TELEGRAM_CHAT_ID=

# ---- n8n ----
N8N_API_KEY=

# ---- Storage paths ----
DEMO_VIDEO_PATH=
VIDEO_ARCHIVE_DIR=
SCRIPT_PROFILE=standard_35s
LONGFORM_PROFILE=long_8m
PUBLISH_MODE=review
AUTO_PUBLISH_APPROVED=false
