# Deny everything by default: the runner image only needs the files below.
# The repo itself is bind-mounted by compose.yaml, not copied into the image.
**
!Dockerfile.runner
!n8n_runner.py
!requirements.txt

# Explicit secret/state exclusions (defense in depth; already covered by **)
.env
.env.*
.n8n-docker.env
*token*.json
*credentials*.json
*client_secret*.json
secrets/
credentials/
*.pem
*.key
data/
outputs/
output/
shots/
media/
archive/
.venv/
venv/
__pycache__/
